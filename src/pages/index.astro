---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Bradley Lignoski
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate font-medium text-black dark:text-white">
            ML Engineer · CS &amp; mathematics educator · Mechanistic Interpretability Enthusiast.
            Just finished my MS in AI/ML at Johns Hopkins.
          </p>

          <div class="animate flex flex-col sm:flex-row sm:items-start gap-6">
            <!-- TODO: replace with profile photo. Drop a square image at /public/images/profile.jpg and swap the src below. -->
            <div
              class="shrink-0 size-28 rounded-lg border border-black/15 dark:border-white/20 flex items-center justify-center text-xs opacity-50 select-none"
              aria-hidden="true"
            >
              photo
            </div>
            <div class="space-y-4">
              <p>
                {/* TODO: write a 3–5 sentence intro paragraph. Placeholder below. */}
                I build and study machine-learning systems, and I have spent over a
                decade teaching computer science and mathematics. My interests sit at
                the intersection of interpretability research, applied ML, and
                education. This site collects my projects, teaching, and a bit about
                the climbing life outside of work.
              </p>
              <p class="text-sm opacity-75">
                <span class="font-semibold text-black dark:text-white">Currently (Spring 2026):</span>
                building a React Native mobile app for gym climbers and pursuing roles
                in AI safety / interpretability research, ML engineering, and CS
                education.
              </p>
            </div>
          </div>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's connect
        </h5>
        <article>
          <p>
            Reach out about research, engineering, or teaching roles, or just to say hi.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
